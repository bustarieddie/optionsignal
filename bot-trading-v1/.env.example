# =============================================================================
# BOT TRADING v1.0 — environment variables (example). Copy to .env.
# SECRETS LIVE HERE, NOT IN YAML OR SOURCE. Never commit a real .env.
# =============================================================================

# --- runtime mode ---
ENVIRONMENT=paper                 # backtest | paper | live
LIVE_TRADING_ENABLED=false        # HARD gate #1 for live orders
LIVE_CONFIRMATION_PHRASE=         # HARD gate #2: must equal LIVE_CONFIRMATION_EXPECTED
LIVE_CONFIRMATION_EXPECTED=       # the value you require operators to type/set

# --- webhook auth (see docs/05-webhook-and-security.md) ---
WEBHOOK_SECRET=change-me-to-a-long-random-string
URL_TOKEN=change-me-random-url-path-token
HMAC_REQUIRED=false               # true only when an n8n/proxy signer is in front
IP_ALLOWLIST=                     # comma-separated; blank = disabled

# --- admin ---
ADMIN_TOKEN=change-me-admin-bearer-token

# --- infra (blank uses in-memory / sqlite for local dev) ---
DATABASE_URL=sqlite+pysqlite:///./bot.db
REDIS_URL=
SIGNAL_DEDUP_TTL=3600

# --- secrets encryption for stored broker credentials ---
SECRETS_ENC_KEY=

# --- notifications (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
N8N_WEBHOOK_URL=
SMTP_URL=

# --- broker credentials (only used once you wire a real live adapter) ---
# BROKER_KIND=live
# BROKER_API_KEY=
# BROKER_API_SECRET=
# BROKER_ACCOUNT_ID=
